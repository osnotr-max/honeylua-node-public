# Honeylua Discord — preencha os campos obrigatórios antes de iniciar.
DISCORD_TOKEN=
GUILD_ID=
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
STAFF_ROLE_ID=

# IDs dos cargos; listas aceitam IDs separados por vírgula.
STAFF_REPORT_ROLE_IDS=
USER_REPORT_ROLE_ID=
SUPPORT_MENTION_ROLE_IDS=

# Opcionais; em branco, TRANSCRIPT_CHANNEL_ID usa LOG_CHANNEL_ID.
TRANSCRIPT_CHANNEL_ID=
MAX_TICKETS_PER_USER=3
COOLDOWN_CREATE_SECS=30
ACTION_COOLDOWN_SECS=3
MAX_TICKETS_PER_GUILD=50
MENTION_STAFF_ON_CREATE=true
MENTION_STAFF_ON_UNCLAIM=true
MAX_TRANSCRIPT_PAGES=6
MAX_TRANSCRIPT_MESSAGES=500
TRANSCRIPT_PAGE_DELAY_MS=350
DISCORD_REQUEST_TIMEOUT_MS=15000
MAX_TRANSCRIPT_BYTES=1572864

# Não coloque este arquivo real no GitHub. O .gitignore exclui .env.
